@model List<ProductCategory>
@{ ViewData["Title"] = "التصنيفات"; Layout = "_AdminLayout"; }
<div class="admin-heading"><div><div class="eyebrow">هيكل الكتالوج</div><h1>التصنيفات والأقسام</h1><p>نظّم المنتجات، وأخفِ قسماً مؤقتاً من المتجر دون فقد بياناته.</p></div><div class="heading-actions"><a class="button light" href="/admin/subcategories/new">+ قسم فرعي</a><a class="button dark" href="/admin/categories/new">+ تصنيف رئيسي</a></div></div>
@if (Model.Count == 0) { <div class="empty-state"><span class="empty-icon">▦</span><h2>ابدأ بتنظيم منتجاتك</h2><p>أنشئ تصنيفاً رئيسياً، ثم قسماً فرعياً داخله قبل إضافة المنتجات.</p><a class="button dark" href="/admin/categories/new">إنشاء أول تصنيف</a></div> }
else { <div class="category-grid">@foreach (var category in Model) { <section class="panel category-panel"><div class="category-top"><div><h2>@category.Name</h2><p>@category.Description</p></div><span class="badge @(category.IsActive ? "" : "badge-off")">@(category.IsActive ? "ظاهر" : "مخفي")</span></div><div class="category-meta"><span>@category.SubCategories.Count قسم فرعي</span><span>@category.SubCategories.Sum(x => x.Products.Count) منتج</span><a href="/admin/categories/@category.Id/edit">تعديل التصنيف ←</a></div><div class="subcategory-list">@foreach (var sub in category.SubCategories.OrderBy(x => x.SortOrder).ThenBy(x => x.Name)) { <div><span class="sub-name">@sub.Name <small>@sub.Products.Count منتج</small></span><span class="badge @(sub.IsActive ? "" : "badge-off")">@(sub.IsActive ? "ظاهر" : "مخفي")</span><a href="/admin/subcategories/@sub.Id/edit">تعديل</a></div> }</div><a class="add-sub" href="/admin/subcategories/new?categoryId=@category.Id">+ إضافة قسم تحت @category.Name</a></section> }</div> }
