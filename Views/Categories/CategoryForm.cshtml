@model CategoryInput
@{ ViewData["Title"] = Model.Id == 0 ? "إضافة تصنيف" : "تعديل تصنيف"; Layout = "_AdminLayout"; }
<div class="admin-heading"><div><a class="breadcrumb" href="/admin/categories">← التصنيفات</a><h1>@ViewData["Title"]</h1><p>إخفاء التصنيف يخفي أقسامه ومنتجاته من المتجر ومساعد الطلبات.</p></div></div><form class="form-card admin-form" method="post" action="/admin/categories/save">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@Model.Id" /><div asp-validation-summary="All" class="validation"></div><label>اسم التصنيف <input name="Name" value="@Model.Name" maxlength="80" required /></label><label>الوصف <textarea name="Description" maxlength="300">@Model.Description</textarea></label><label>ترتيب الظهور <input type="number" name="SortOrder" min="0" value="@Model.SortOrder" /></label><label class="checkbox"><input type="checkbox" name="IsActive" value="true" checked="@Model.IsActive" /> ظاهر للزبائن</label><input type="hidden" name="IsActive" value="false" /><button class="button dark" type="submit">حفظ التصنيف ↗</button></form>
