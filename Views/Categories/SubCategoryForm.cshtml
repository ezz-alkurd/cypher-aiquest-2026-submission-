@model SubCategoryInput
@{ ViewData["Title"] = Model.Id == 0 ? "إضافة قسم فرعي" : "تعديل قسم فرعي"; Layout = "_AdminLayout"; var parents = ViewBag.Parents as List<ProductCategory> ?? new(); }
<div class="admin-heading"><div><a class="breadcrumb" href="/admin/categories">← التصنيفات</a><h1>@ViewData["Title"]</h1><p>اربط القسم بتصنيف رئيسي ثم اختره عند إضافة المنتجات.</p></div></div><form class="form-card admin-form" method="post" action="/admin/subcategories/save">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@Model.Id" /><div asp-validation-summary="All" class="validation"></div><label>التصنيف الرئيسي <select name="ParentCategoryId" required><option value="0">اختر التصنيف</option>@foreach (var parent in parents) { <option value="@parent.Id" selected="@(Model.ParentCategoryId == parent.Id)">@parent.Name</option> }</select></label><label>اسم القسم الفرعي <input name="Name" value="@Model.Name" maxlength="80" required /></label><label>الوصف <textarea name="Description" maxlength="300">@Model.Description</textarea></label><label>ترتيب الظهور <input type="number" name="SortOrder" min="0" value="@Model.SortOrder" /></label><label class="checkbox"><input type="checkbox" name="IsActive" value="true" checked="@Model.IsActive" /> ظاهر للزبائن</label><input type="hidden" name="IsActive" value="false" /><button class="button dark" type="submit">حفظ القسم ↗</button></form>
