@{ var basePath = Context.Items["StoreBasePath"] as string ?? ""; }
@model Product
@{ ViewData["Title"] = Model.Name; }
<div class="shell product-detail"><a class="breadcrumb" href="@(basePath)/shop">الرئيسية</a><span>/</span><span>@Model.Category</span><div class="detail-grid"><div class="detail-image"><img src="@(Model.ImageUrl ?? "/images/placeholder.svg")" alt="@Model.Name" /></div><div class="detail-copy"><div class="eyebrow">@Model.Category / @Model.Sku</div><h1>@Model.Name</h1><p>@Model.Description</p><div class="detail-price">@Model.Price.ToString("0.00") <small>د.أ / @Model.Unit</small></div><div class="stock-label">@(Model.StockQuantity > 0 ? $"متوفر · {Model.StockQuantity} {Model.Unit}" : "نفد المخزون")</div><form method="post" action="@(basePath)/cart/add" class="detail-form">@Html.AntiForgeryToken()<input type="hidden" name="productId" value="@Model.Id" /><input type="hidden" name="returnTo" value="@Context.Request.Path" /><label>الكمية <input type="number" name="quantity" value="1" min="1" max="@Model.StockQuantity" /></label><button class="button dark" type="submit" disabled="@(Model.StockQuantity == 0)">أضف إلى السلة ↗</button></form></div></div></div>
