@{ var basePath = Context.Items["StoreBasePath"] as string ?? ""; }
@model CartViewModel
@{ ViewData["Title"] = "سلة المشتريات"; }
<div class="shell page-section"><div class="eyebrow">طلبك</div><h1 class="page-title">سلة المشتريات</h1>@if (!Model.Lines.Any()) { <div class="empty-state"><h2>سلتك فارغة حالياً</h2><p>تصفح المنتجات وأضف ما يعجبك.</p><a class="button dark" href="@(basePath)/shop">تصفح المنتجات ↗</a></div> } else { <div class="cart-layout"><div class="cart-list">@foreach (var line in Model.Lines) { <div class="cart-item"><img src="@(line.Product.ImageUrl ?? "/images/placeholder.svg")" alt="@line.Product.Name" /><div><a href="@(basePath)/products/@line.Product.Id"><strong>@line.Product.Name</strong></a><small>@line.Product.Price.ToString("0.00") د.أ / @line.Product.Unit</small></div><form method="post" action="@(basePath)/cart/update">@Html.AntiForgeryToken()<input type="hidden" name="productId" value="@line.Product.Id" /><input type="number" name="quantity" min="0" max="@line.Product.StockQuantity" value="@line.Quantity" aria-label="كمية @line.Product.Name" /><button type="submit">تحديث</button></form><strong>@line.Total.ToString("0.00") د.أ</strong></div> }</div><aside class="summary-card"><h2>ملخص الطلب</h2><div><span>المنتجات</span><strong>@Model.Subtotal.ToString("0.00") د.أ</strong></div><div><span>التوصيل</span><strong>@Model.DeliveryFee.ToString("0.00") د.أ</strong></div><div class="summary-total"><span>المجموع</span><strong>@Model.Total.ToString("0.00") د.أ</strong></div><a class="button dark full" href="@(basePath)/checkout">المتابعة للطلب ↗</a></aside></div> }</div>
