@{ ViewData["Title"] = "دخول فريق Cypher"; Layout = "_PlatformLayout"; }
<section class="login-wrap"><form class="form-card login-card" method="post" action="/platform/operator/login">@Html.AntiForgeryToken()<span class="eyebrow">لفريق Cypher فقط</span><h1>دخول المشغل</h1><p>مراجعة طلبات الانضمام الواردة.</p><div asp-validation-summary="All" class="validation"></div><label>اسم المستخدم <input name="username" required autocomplete="username" /></label><label>كلمة المرور <input name="password" type="password" required autocomplete="current-password" /></label><button class="button dark full" type="submit">دخول</button></form></section>
