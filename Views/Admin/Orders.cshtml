@model List<ShopOrder>
@{ ViewData["Title"] = "الطلبات"; Layout = "_AdminLayout"; }
<div class="admin-heading"><div><div class="eyebrow">كل القنوات في مكان واحد</div><h1>الطلبات</h1><p>طلبات الموقع والمحادثات تظهر هنا.</p></div></div><div class="tabs"><a href="/admin/orders" class="@(ViewBag.Status == null ? "active" : "")">الكل</a><a href="/admin/orders?status=NeedsReview">تحتاج مراجعة</a><a href="/admin/orders?status=New">جديد</a><a href="/admin/orders?status=Preparing">قيد التجهيز</a><a href="/admin/orders?status=Completed">مكتمل</a></div><section class="panel"><div class="table-scroll"><table><thead><tr><th>رقم الطلب</th><th>العميل</th><th>المصدر</th><th>المنتجات</th><th>المجموع</th><th>الحالة</th><th>التاريخ</th><th></th></tr></thead><tbody>@foreach (var order in Model) { <tr><td><strong>@order.OrderNumber</strong></td><td>@order.CustomerName</td><td>@order.SourceChannel</td><td>@order.Lines.Count</td><td>@order.Total.ToString("0.00") د.أ</td><td><span class="badge">@order.Status</span></td><td>@order.CreatedAtUtc.ToLocalTime().ToString("dd/MM HH:mm")</td><td><a href="/admin/orders/@order.Id">التفاصيل ←</a></td></tr> }@if (!Model.Any()) { <tr><td colspan="8">لا توجد طلبات في هذا القسم.</td></tr> }</tbody></table></div></section>
