@model List<Product>
@{ ViewData["Title"] = "المنتجات والمخزون"; Layout = "_AdminLayout"; }
<div class="admin-heading"><div><div class="eyebrow">الكتالوج والمخزون</div><h1>منتجات المتجر</h1><p>حدّث الأسعار والكميات والصور من مكان واحد.</p></div><a class="button dark" href="/admin/products/new">+ إضافة منتج</a></div>
@if (Model.Count == 0) { <div class="empty-state"><span class="empty-icon">◫</span><h2>لم تضف أي منتج بعد</h2><p>ابدأ بتصنيف وقسم فرعي، ثم أضف أول منتج بصورته وسعره الحقيقي.</p><div class="heading-actions" style="justify-content:center"><a class="button light" href="/admin/categories">إدارة التصنيفات</a><a class="button dark" href="/admin/products/new">إضافة أول منتج</a></div></div> }
else { <section class="panel"><div class="table-scroll"><table><thead><tr><th>المنتج</th><th>الرمز</th><th>التصنيف</th><th>القسم</th><th>السعر</th><th>المخزون</th><th>الحالة</th><th></th></tr></thead><tbody>@foreach (var product in Model) { <tr><td><div class="table-product"><img src="@(product.ImageUrl ?? "/images/placeholder.svg")" alt="" /><strong>@product.Name</strong></div></td><td>@product.Sku</td><td>@product.Category</td><td>@(product.SubCategory?.Name ?? "—")</td><td>@product.Price.ToString("0.00") د.أ</td><td><span class="@(product.StockQuantity <= product.LowStockThreshold ? "low-stock" : "")">@product.StockQuantity</span></td><td><span class="badge">@(product.IsActive ? "ظاهر" : "مخفي")</span></td><td><a href="/admin/products/@product.Id/edit">تعديل ←</a></td></tr> }</tbody></table></div></section> }
