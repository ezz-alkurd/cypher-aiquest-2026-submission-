@model List<StockMovement>
@{ ViewData["Title"] = "حركة المخزون"; Layout = "_AdminLayout"; }
<div class="admin-heading"><div><div class="eyebrow">سجل الكميات</div><h1>حركة المخزون</h1><p>آخر ١٥٠ تغييراً بسبب الطلبات أو تعديلات صاحب المتجر.</p></div><a class="button dark" href="/admin/products">إدارة المنتجات ↗</a></div><section class="panel"><div class="table-scroll"><table><thead><tr><th>الوقت</th><th>المنتج</th><th>التغيير</th><th>السبب</th><th>الطلب</th></tr></thead><tbody>@foreach (var movement in Model) { <tr><td>@movement.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@movement.Product.Name</td><td><strong class="@(movement.QuantityChange < 0 ? "low-stock" : "stock-up")">@(movement.QuantityChange > 0 ? "+" : "")@movement.QuantityChange</strong></td><td>@movement.Reason</td><td>@(movement.OrderId?.ToString() ?? "—")</td></tr> }@if (!Model.Any()) { <tr><td colspan="5">لا توجد حركة مخزون بعد.</td></tr> }</tbody></table></div></section>
