@model ProductInput
@{ ViewData["Title"] = Model.Id == 0 ? "إضافة منتج" : "تعديل منتج"; Layout = "_AdminLayout"; var subs = ViewBag.SubCategories as List<ProductSubCategory> ?? new(); }
<div class="admin-heading"><div><a class="breadcrumb" href="/admin/products">← المنتجات</a><h1>@ViewData["Title"]</h1><p>بيانات هذا المنتج تظهر في المتجر ويستخدمها مساعد الطلبات.</p></div></div>
@if (subs.Count == 0) { <div class="empty-state"><span class="empty-icon">▦</span><h2>أنشئ قسماً فرعياً أولاً</h2><p>كل منتج يحتاج إلى تصنيف رئيسي وقسم فرعي حتى يظهر في المتجر.</p><a class="button dark" href="/admin/categories">إدارة التصنيفات</a></div> }
else { <form class="form-card admin-form" method="post" action="/admin/products/save" enctype="multipart/form-data">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@Model.Id" /><input type="hidden" name="ImageUrl" value="@Model.ImageUrl" /><div asp-validation-summary="All" class="validation"></div><div class="form-grid"><label>اسم المنتج <input name="Name" value="@Model.Name" required maxlength="140" /></label><label>رمز المنتج (SKU) <input name="Sku" value="@Model.Sku" required maxlength="50" /></label><label>القسم الفرعي <select name="SubCategoryId" required><option value="0">اختر القسم</option>@foreach (var sub in subs) { <option value="@sub.Id" selected="@(Model.SubCategoryId == sub.Id)">@sub.ParentCategory.Name / @sub.Name</option> }</select><small><a href="/admin/categories">إدارة التصنيفات والأقسام</a></small></label><label>وحدة البيع <input name="Unit" value="@Model.Unit" maxlength="50" /></label><label>السعر بالدينار <input type="number" step="0.01" min="0" name="Price" value="@Model.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" /></label><label>كمية المخزون <input type="number" min="0" name="StockQuantity" value="@Model.StockQuantity" /></label><label>حد التنبيه المنخفض <input type="number" min="0" name="LowStockThreshold" value="@Model.LowStockThreshold" /></label><label>صورة المنتج <input type="file" name="Image" accept="image/jpeg,image/png,image/webp" /></label></div><label>الوصف <textarea name="Description" maxlength="1000">@Model.Description</textarea></label><label>أسماء بديلة للبحث والمساعد <input name="Aliases" value="@Model.Aliases" maxlength="500" /></label><label class="checkbox"><input type="checkbox" name="IsActive" value="true" checked="@Model.IsActive" /> ظاهر في المتجر</label><input type="hidden" name="IsActive" value="false" /><button class="button dark" type="submit">حفظ المنتج ↗</button></form> }
