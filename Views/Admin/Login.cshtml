@{ ViewData["Title"] = "دخول صاحب النشاط"; Layout = "_PlatformLayout"; }
<div class="login-wrap"><form class="form-card login-card" method="post" action="/admin/login">@Html.AntiForgeryToken()<div class="eyebrow">بوابة Cypher</div><h1>أهلاً بعودتك.</h1><p>أدخل بيانات حسابك لإدارة نشاطك والخدمات المفعلة.</p><div asp-validation-summary="All" class="validation"></div><label>اسم المستخدم <input name="username" autocomplete="username" required /></label><label>كلمة المرور <input name="password" type="password" autocomplete="current-password" required /></label><button class="button dark full" type="submit">دخول إلى البوابة ↗</button><small>ليس لديك حساب؟ <a href="/platform/request">اطلب الانضمام</a></small></form></div>
